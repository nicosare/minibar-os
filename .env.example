# PostgreSQL
POSTGRES_DB=minibar_db
POSTGRES_USER=minibar
POSTGRES_PASSWORD=CHANGE_ME

# Backend
DATABASE_URL=postgresql://minibar:CHANGE_ME@db:5432/minibar_db
PORT=3000
NODE_ENV=production
TZ=Europe/Warsaw
APP_TIMEZONE=Europe/Warsaw

# VK Proxy
# Photo proxy reuses VK_BOT_ACCESS_TOKEN; no second token is needed.
VK_API_VERSION=5.199
# Confirmed Mini Bar conversation peer_id.
VK_DEFAULT_PEER_ID=2000000001
# Optional; if empty, Docker Compose reuses VK_BOT_ALLOWED_PEER_IDS.
VK_ALLOWED_PEER_IDS=2000000001
VK_PROXY_PORT=3001

# VK Bot
# Dedicated community token for the MiniBar OS bot.
VK_BOT_ACCESS_TOKEN=CHANGE_ME
# Leave empty to auto-detect the group from VK_BOT_ACCESS_TOKEN.
VK_BOT_GROUP_ID=
# Conversation where the community bot listens and the Mini App sends room photos.
VK_BOT_ALLOWED_PEER_IDS=2000000001
VK_LONGPOLL_VERSION=3
# Generate with: openssl rand -hex 32
VK_BOT_INTERNAL_TOKEN=CHANGE_ME
