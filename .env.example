# PostgreSQL
POSTGRES_DB=minibar_db
POSTGRES_USER=minibar
POSTGRES_PASSWORD=CHANGE_ME

# Backend
DATABASE_URL=postgresql://minibar:CHANGE_ME@db:5432/minibar_db
PORT=3000
NODE_ENV=production
TZ=Europe/Warsaw
APP_TIMEZONE=Europe/Warsaw

# VK Proxy
VK_ACCESS_TOKEN=CHANGE_ME
VK_API_VERSION=5.199
# Optional when VK_ALLOWED_PEER_IDS contains exactly one peer; otherwise set explicitly.
VK_DEFAULT_PEER_ID=
# Optional; if empty, Docker Compose uses VK_BOT_ALLOWED_PEER_IDS as the allowlist.
VK_ALLOWED_PEER_IDS=
VK_PROXY_PORT=3001

# VK Bot
# Dedicated community token for the new MiniBar OS bot.
VK_BOT_ACCESS_TOKEN=CHANGE_ME
# Leave empty to auto-detect the group from VK_BOT_ACCESS_TOKEN.
VK_BOT_GROUP_ID=
# Example/test conversation — replace with the actual conversation peer_id.
VK_BOT_ALLOWED_PEER_IDS=2000000352
VK_LONGPOLL_VERSION=3
# Generate with: openssl rand -hex 32
VK_BOT_INTERNAL_TOKEN=CHANGE_ME
