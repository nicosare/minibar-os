# PostgreSQL
POSTGRES_DB=minibar_db
POSTGRES_USER=minibar
POSTGRES_PASSWORD=CHANGE_ME

# Backend
DATABASE_URL=postgresql://minibar:CHANGE_ME@db:5432/minibar_db
PORT=3000
NODE_ENV=production
TZ=Europe/Warsaw
APP_TIMEZONE=Europe/Warsaw

# VK Proxy
VK_ACCESS_TOKEN=CHANGE_ME
VK_API_VERSION=5.199
VK_DEFAULT_PEER_ID=CHANGE_ME
VK_ALLOWED_PEER_IDS=CHANGE_ME
VK_PROXY_PORT=3001

# VK Bot
# Dedicated community token for the new MiniBar OS bot.
VK_BOT_ACCESS_TOKEN=CHANGE_ME
# Leave empty to auto-detect the group from VK_BOT_ACCESS_TOKEN.
VK_BOT_GROUP_ID=
# Test conversation.
VK_BOT_ALLOWED_PEER_IDS=2000000352
VK_LONGPOLL_VERSION=3
# Generate with: openssl rand -hex 32
VK_BOT_INTERNAL_TOKEN=CHANGE_ME
