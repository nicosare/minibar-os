# PostgreSQL
POSTGRES_DB=minibar_db
POSTGRES_USER=minibar
POSTGRES_PASSWORD=CHANGE_ME

# Backend
DATABASE_URL=postgresql://minibar:CHANGE_ME@db:5432/minibar_db
PORT=3000
NODE_ENV=production
TZ=Europe/Warsaw
APP_TIMEZONE=Europe/Warsaw

# VK API
VK_API_VERSION=5.199
VK_PROXY_PORT=3001
# The photo proxy automatically uses the single conversation listed below
# in VK_BOT_ALLOWED_PEER_IDS; no separate destination ID is required.

# VK Bot
# Preferred shared community token for the bot and photo proxy.
# Existing installations may keep using VK_ACCESS_TOKEN as a compatibility fallback.
VK_BOT_ACCESS_TOKEN=CHANGE_ME
# Leave empty to auto-detect the group from VK_BOT_ACCESS_TOKEN.
VK_BOT_GROUP_ID=
# Single source of truth: chats listened to by the bot and used by the Mini App.
VK_BOT_ALLOWED_PEER_IDS=2000000001
VK_LONGPOLL_VERSION=3
# Generate with: openssl rand -hex 32
VK_BOT_INTERNAL_TOKEN=CHANGE_ME

# VK Callback API (configured in the VK community settings)
VK_CALLBACK_SECRET=CHANGE_ME
VK_CALLBACK_CONFIRMATION=CHANGE_ME
# Host port forwarded to the Callback API container (normally 3002)
VK_BOT_HTTP_PORT=3002
